{
  "name": "oft-bridge-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge any LayerZero OFT token — a non-custodial static UI that reads the contract and builds the transaction.",
  "license": "MIT",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "headers": "node scripts/gen-headers.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:whitelist": "node scripts/check-whitelist.mjs",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test": "npm run check:whitelist && npm run test:unit"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "5.103.1",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.8",
    "wagmi": "2.19.5"
  },
  "overrides": {
    "postcss": "8.5.28",
    "ws@8": "8.21.3",
    "uuid@8": "11.1.1",
    "uuid@9": "11.1.1",
    "decode-uri-component": "0.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
