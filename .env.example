# Copy to .env.local. All values are public (NEXT_PUBLIC_*) — nothing secret lives here.
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_CANONICAL_DOMAIN=
NEXT_PUBLIC_REPO_URL=
# Extra connect-src hosts for the generated CSP (space-separated), e.g. a self-hosted RPC.
CSP_CONNECT_EXTRA=
# Optional. Robinhood Chain's public RPC is rate-limited and its operator publishes no second one;
# set your own node here and it goes in front of the public endpoints. https only — the build puts
# whatever is set here into the CSP's connect-src, so it can never be a host the browser blocks.
NEXT_PUBLIC_RPC_ROBINHOOD=
