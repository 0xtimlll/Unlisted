# Exact versions only; every dependency is a deliberate decision (§7).
save-exact=true
fund=false
audit=true
# No package may run code at install time (§7). The runtime is defended by the CSP and
# scripts/check-whitelist.mjs; the BUILD was defended by nothing, and a lifecycle script in any
# transitive dependency runs on every `npm ci` — on CI and on the machine that deploys.
# Every native addon in this tree (bigint-buffer, keccak, bufferutil, utf-8-validate) ships a
# pure-JS fallback, which is what audit-exceptions.json already assumes is the one in use.
ignore-scripts=true
