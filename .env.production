# Public build-time values. Committed on purpose: nothing here is secret.
# Cloudflare Pages names the project after the repo → oft-bridge-ui.pages.dev.
# Change this when a custom domain is attached.
NEXT_PUBLIC_CANONICAL_DOMAIN=oft-bridge-ui.pages.dev
# The GitHub repository the footer links to. The project is Unlisted; the owner part is the account's login.
NEXT_PUBLIC_REPO_URL=https://github.com/0xtimlll/oft-bridge-ui
# WalletConnect is off in v1: only browser (injected) wallets. See README to enable.
NEXT_PUBLIC_WC_PROJECT_ID=
